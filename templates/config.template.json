{
  "_comment": "Copy this file to config.json and customize for your job search.",

  "search": {
    "_comment": "Keywords and locations for LinkedIn job search",
    "keywords": "product manager AI",
    "locations": [
      {
        "name": "Greater Boston",
        "linkedin_filter": "Greater Boston"
      },
      {
        "name": "Remote USA",
        "linkedin_filter": "United States",
        "remote_only": true
      }
    ],
    "max_results_per_search": 70,
    "results_file": "output/linkedin_extract_today.json"
  },

  "scoring": {
    "_comment": "Priority thresholds and scoring weights",
    "priority_thresholds": {
      "high": 80,
      "medium": 65
    },
    "domain_weights": {
      "AI/ML": 8,
      "Healthcare": 12,
      "Finance": 8,
      "Enterprise": 4,
      "Cybersecurity": 8,
      "E-commerce": 6,
      "Infrastructure": 8,
      "Mobile": 4
    },
    "candidate_domains": ["AI/ML", "Healthcare", "Finance", "Enterprise"],
    "location_preferences": {
      "exact_match": 10,
      "remote": 8,
      "other_us": 3
    },
    "preferred_location": "Boston"
  },

  "resume_tailoring": {
    "_comment": "Resume generation and quality control settings",
    "bullet_max_words": 25,
    "quality_gate_threshold": 75,
    "human_review_threshold": 70,
    "max_highlights": 4,
    "max_bullets_per_highlight": 5
  },

  "journal": {
    "path": "journal.xlsx",
    "sheets": ["Jobs", "Applications", "Resume Versions", "Reference"]
  },

  "output_dir": "output",
  "resume_dir": "resume/tailored"
}