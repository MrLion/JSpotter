{
  "_comment": "Copy to config.json and customize. See docs/SETUP.md for details.",
  "candidate": {
    "_comment": "Candidate identity, career order, conflation detection, and client keyword config. Set include_name_in_filename to false to omit the candidate name from generated PDF filenames.",
    "name": "Your Name",
    "full_name": "Your Full Legal Name",
    "career_order": [
      {"keywords": ["Employer1"], "dates": "(Year–Year)"},
      {"keywords": ["Employer2"], "dates": "(Year–Year)"}
    ],
    "conflation_metrics": {
      "_comment": "Map a metric string to the client/employer it belongs to. Prevents one engagement's metric being misattributed to another.",
      "example_metric": ["employer_key"]
    },
    "client_keywords": {
      "_comment": "Map a client key to the keywords that identify it in a job description.",
      "employer_key": ["keyword1", "keyword2"]
    },
    "client_names_in_profile": {
      "_comment": "Map a client key to the display name used on the resume for that client engagement.",
      "employer_key": "Employer Display Name"
    },
    "bad_keywords": [
      "Sole Proprietor",
      "Entrepreneur"
    ],
    "pandering_phrases": [
      "directly relevant to",
      "well-suited for",
      "perfectly aligned",
      "ideal candidate",
      "applicable to"
    ],
    "client_employment_regex": "\\bat (Employer1|Employer2)\\b",
    "include_name_in_filename": true
  },
  "search": {
    "keywords": "product manager AI",
    "locations": [
      {
        "name": "USA",
        "linkedin_filter": "United States"
      }
    ],
    "max_results_per_search": 70,
    "results_file": "output/linkedin_extract.json",
    "title_filter_terms": ["manager", "director", "vp", "vice president", "head", "lead", "owner"]
  },
  "scoring": {
    "priority_thresholds": {
      "high": 80,
      "medium": 65
    },
    "domain_weights": {
      "AI/ML": 8,
      "Healthcare": 12,
      "Finance": 8,
      "Capital Markets": 12,
      "Enterprise/B2B": 4,
      "Cybersecurity": 8,
      "E-commerce/Consumer": 6,
      "Infrastructure/DevOps": 8,
      "Mobile/Hardware": 4,
      "Life Sciences/Bioprocessing": 12,
      "Semiconductor/Materials R&D": 12,
      "Public Sector/Transportation": 8
    },
    "domains": {
      "AI/ML": {
        "weight": 8,
        "has_in_profile": true,
        "keywords": ["ai", "ml", "machine learning", "genai", "llm", "artificial intelligence", "agentic", "ai agent", "generative ai"]
      },
      "Healthcare": {
        "weight": 12,
        "has_in_profile": true,
        "keywords": ["healthcare", "health", "ehr", "clinical", "patient", "medical", "pharma", "biotech", "medicare", "insurance", "provider"]
      },
      "Finance": {
        "weight": 8,
        "has_in_profile": true,
        "keywords": ["finance", "financial", "fintech", "banking", "payment processing", "financial compliance"]
      },
      "Capital Markets": {
        "weight": 12,
        "has_in_profile": false,
        "keywords": ["trading", "capital markets", "investment bank", "portfolio management", "fixed income", "asset manager", "hedge fund"]
      },
      "Enterprise/B2B": {
        "weight": 4,
        "has_in_profile": true,
        "keywords": ["enterprise", "b2b", "saas", "crm", "erp", "workflow", "automation", "digital transformation"]
      },
      "Cybersecurity": {
        "weight": 8,
        "has_in_profile": false,
        "keywords": ["cybersecurity", "threat detection", "vulnerability management", "encryption", "security operations", "siem", "zero trust"]
      },
      "E-commerce/Consumer": {
        "weight": 6,
        "has_in_profile": false,
        "keywords": ["ecommerce", "marketplace", "retail", "b2c", "consumer", "loyalty"]
      },
      "Infrastructure/DevOps": {
        "weight": 8,
        "has_in_profile": false,
        "keywords": ["infrastructure", "devops", "kubernetes", "docker", "sre", "observability", "reliability"]
      },
      "Mobile/Hardware": {
        "weight": 4,
        "has_in_profile": false,
        "keywords": ["mobile", "ios", "android", "hardware", "embedded", "firmware", "device", "iot"]
      },
      "Life Sciences/Bioprocessing": {
        "weight": 12,
        "has_in_profile": false,
        "keywords": ["bioprocessing", "chromatography", "biologics", "biopharmaceutical", "fermentation", "cell culture", "purification", "gmp"]
      },
      "Semiconductor/Materials R&D": {
        "weight": 12,
        "has_in_profile": false,
        "keywords": ["semiconductor", "materials science", "advanced materials", "silicon", "wafer", "thin film", "lithography"]
      },
      "Public Sector/Transportation": {
        "weight": 8,
        "has_in_profile": false,
        "keywords": ["public sector", "transportation", "transit", "government", "municipal", "fleet", "scheduling", "dispatch"]
      }
    },
    "candidate_domains": [
      "AI/ML",
      "Healthcare",
      "Finance",
      "Enterprise/B2B"
    ],
    "location_preferences": {
      "exact_match": 10,
      "remote": 8,
      "other_us": 3
    },
    "preferred_location": "Boston"
  },
  "hard_constraints": {
    "_comment": "Deal-breaker gates checked BEFORE scoring. Set your own values; leave a key out or null to disable that gate. Jobs failing a gate get Recommendation=SKIP with reason.",
    "comp_floor": 0,
    "allowed_locations": ["Your City", "Remote"],
    "location_tokens": {
      "Your City": ["your city", ", yourstate"],
      "Remote": ["remote", "work from home", "wfh", "distributed", "anywhere in the us", "us remote", "remote-first"]
    },
    "remote_tokens": ["remote", "work from home", "wfh", "distributed", "anywhere in the us", "us remote", "remote-first"],
    "onsite_tolerance": "hybrid",
    "onsite_phrases": ["on-site 5 days", "onsite 5 days", "in-office 5 days", "in office 5 days", "100% onsite", "100% on-site", "fully onsite", "fully on-site", "five days a week on-site", "5 days/week on-site", "on-site, 5"],
    "generic_onsite_words": ["downtown", "headquarters", "office", "campus", "hq", "the", "our", "a", "an", "one", "person", "hybrid"],
    "specific_location_states": ["ma", "ny", "ca", "tx", "fl", "il", "pa", "oh", "ga", "nc", "va", "wa", "az", "co", "ut", "ct", "ri", "massachusetts", "new york", "california", "texas", "florida", "illinois", "pennsylvania", "ohio", "georgia", "north carolina", "virginia", "washington", "arizona", "colorado", "utah", "connecticut", "rhode island"],
    "salary_sanity": {"min_annual": 50000, "max_annual": 2000000},
    "max_years_required": 20,
    "text_blockers": ["security clearance", "must be a us citizen"]
  },
  "resume_tailoring": {
    "bullet_max_words": 35,
    "quality_gate_threshold": 75,
    "human_review_threshold": 70,
    "max_highlights": 4,
    "max_bullets_per_highlight": 5
  },
  "journal": {
    "path": "journal.xlsx",
    "sheets": ["Jobs", "Applications", "Resume Versions", "Reference"]
  },
  "output_dir": "output",
  "resume_dir": "resume/tailored",
  "credentials": {
    "_comment": "Local only — never push to repo. gitignore protects config.json.",
    "adzuna": {
      "app_id": "your_adzuna_app_id",
      "app_key": "your_adzuna_app_key"
    },
    "dice": {
      "email": "your_email@example.com",
      "password": "***"
    },
    "linkedin": {
      "email": "your_email@example.com",
      "password": "***"
    }
  },
  "dedup": {
    "job_board_domains": [
      "efinancialcareers.com",
      "indeed.com",
      "glassdoor.com",
      "ziprecruiter.com",
      "monster.com",
      "careerbuilder.com",
      "simplyhired.com",
      "lensa.com",
      "theladders.com"
    ]
  }
}
