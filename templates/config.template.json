{
  "_comment": "Copy to config.json and customize. See docs/SETUP.md for details.",
  "candidate": {
    "_comment": "Candidate name, career order, conflation metrics, and client keywords for validation. Set include_name_in_filename to false to omit the candidate name from generated PDF filenames.",
    "name": "Your Name",
    "career_order": [
      {"keywords": ["Employer1"], "dates": "(Year–Year)"},
      {"keywords": ["Employer2"], "dates": "(Year–Year)"}
    ],
    "conflation_metrics": {},
    "client_keywords": {}
  },
"search": {
    "keywords": "product manager AI",
    "locations": [
      {
        "name": "Greater Boston",
        "linkedin_filter": "Greater Boston"
      },
      {
        "name": "Remote USA",
        "linkedin_filter": "United States",
        "remote_only": true
      }
    ],
    "max_results_per_search": 70,
    "results_file": "output/linkedin_extract_today.json",
    "title_filter_terms": ["manager", "director", "vp", "vice president", "head", "lead", "owner"]
  },
  "scoring": {
    "priority_thresholds": {
      "high": 80,
      "medium": 65
    },
    "domain_weights": {
      "AI/ML": 8,
      "Healthcare": 12,
      "Finance": 8,
      "Enterprise": 4,
      "Cybersecurity": 8,
      "E-commerce": 6,
      "Infrastructure": 8,
      "Mobile": 4
    },
    "candidate_domains": [
      "AI/ML",
      "Healthcare",
      "Finance",
      "Enterprise"
    ],
    "location_preferences": {
      "exact_match": 10,
      "remote": 8,
      "other_us": 3
    },
    "preferred_location": "Boston"
  },
  "resume_tailoring": {
    "bullet_max_words": 35,
    "quality_gate_threshold": 75,
    "human_review_threshold": 70,
    "max_highlights": 4,
    "max_bullets_per_highlight": 5
  },
  "credentials": {
    "_comment": "Local only — never push to repo. gitignore protects config.json.",
    "dice": {
      "email": "your_email@example.com",
      "password": "***"
    },
    "linkedin": {
      "email": "your_email@example.com",
      "password": "***"
    }
  },
  "dedup": {
    "_comment": "Job board domains to filter out during Dice apply URL extraction",
    "job_board_domains": [
      "efinancialcareers.com",
      "indeed.com",
      "glassdoor.com",
      "ziprecruiter.com",
      "monster.com",
      "careerbuilder.com",
      "simplyhired.com",
      "lensa.com",
      "theladders.com"
    ]
  },
  "journal": {
    "path": "journal.xlsx",
    "sheets": [
      "Jobs",
      "Applications",
      "Resume Versions",
      "Reference"
    ]
  },
  "output_dir": "output",
  "resume_dir": "resume/tailored"
}
